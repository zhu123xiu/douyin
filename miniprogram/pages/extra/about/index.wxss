.about-hero {
  padding: 34rpx 32rpx 38rpx;
  background: linear-gradient(145deg, #f5e6dc, #edd0c8);
}

.about-hero__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #986fc9;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-hero__title {
  margin-top: 24rpx;
  color: #30231e;
  font-size: 48rpx;
  font-weight: 800;
}

.about-hero__subtitle {
  margin-top: 10rpx;
  color: #735f56;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
}

.about-hero__desc {
  margin-top: 22rpx;
  color: #806d64;
  font-size: 26rpx;
  line-height: 1.85;
  text-align: justify;
}
