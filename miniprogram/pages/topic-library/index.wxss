.library-page {
  padding-bottom: 48rpx;
}

.page-title {
  font-size: 46rpx;
  font-weight: 800;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(125, 96, 80, 0.08);
}

.search-box__icon {
  color: #ab9c93;
  font-size: 32rpx;
}

.search-box__input {
  flex: 1;
  font-size: 27rpx;
}

.search-box__clear {
  color: #c8bbb2;
  font-size: 34rpx;
}

.age-tabs {
  width: 100%;
  margin-top: 20rpx;
}

.age-tabs__row,
.level-tabs__row {
  display: flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.level-tabs__row {
  display: inline-flex;
  width: max-content;
  min-width: 100%;
  flex-wrap: nowrap;
}

.age-tab {
  flex-shrink: 0;
  padding: 11rpx 24rpx;
  border-radius: 24rpx;
  background: #f5ede6;
  color: #9b8d84;
  font-size: 23rpx;
}

.age-tab--active {
  background: #c4956a;
  color: #ffffff;
}

.mode-tabs {
  display: flex;
  margin-top: 22rpx;
  padding: 6rpx;
  border-radius: 24rpx;
  background: #f0e7e1;
}

.mode-tab {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  color: #927f75;
  font-size: 25rpx;
  text-align: center;
}

.mode-tab--active {
  background: #ffffff;
  color: #c4956a;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(112, 85, 71, 0.06);
}

.subheading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.subheading::before {
  width: 8rpx;
  height: 34rpx;
  border-radius: 6rpx;
  background: #d6ab8e;
  content: "";
}

.subheading--list {
  margin-top: 28rpx;
}

.subheading__count {
  color: #ad9b90;
  font-size: 23rpx;
  font-weight: 400;
}

.level-tabs {
  width: 100%;
  margin-top: 24rpx;
}

.level-pill {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 28rpx;
  background: #f5ede6;
  color: #8a7d76;
  font-size: 24rpx;
}

.level-pill--active {
  background: #c4956a;
  color: #ffffff;
}

.more-pill {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: #f5f5f5;
  color: #8a7d76;
}

.more-pill__icon {
  color: #a99b93;
  font-size: 20rpx;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.library-topic-card {
  padding: 26rpx 28rpx;
}

.topic-card__top,
.topic-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.topic-card__title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.topic-card__preview {
  margin-top: 10rpx;
  color: #9a8980;
  font-size: 24rpx;
  line-height: 1.55;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.topic-card__footer {
  margin-top: 20rpx;
}

.topic-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag--soft {
  background: #f8f1ed;
  color: #9b887e;
}

.tag--ability {
  background: #eaf0f5;
  color: #6b8db5;
}

.today-pill,
.free-pill,
.lock-pill {
  margin-left: auto;
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
  background: #eaf7ef;
  color: #3eaa71;
  font-size: 21rpx;
}

.free-pill {
  background: #eaf7ef;
  color: #3eaa71;
}

.lock-pill {
  background: #faf1e7;
  color: #c4956a;
}

.star-btn--small {
  width: 54rpx;
  height: 54rpx;
  font-size: 28rpx;
}

.skeleton-card {
  padding: 28rpx;
}

.sk-line--lg {
  width: 85%;
}

.sk-line--md {
  width: 55%;
  margin-top: 20rpx;
}

.sk-line--sm {
  width: 30%;
  margin-top: 20rpx;
}
