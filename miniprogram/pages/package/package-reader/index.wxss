.package-reader-page {
  padding-bottom: 54rpx;
}

.reader-eyebrow {
  color: #c4956a;
  font-size: 24rpx;
  font-weight: 700;
}

.reader-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.4;
}

.reader-lock-tip {
  margin-top: 24rpx;
  padding: 22rpx 26rpx;
  color: #8b6e58;
  font-size: 24rpx;
  line-height: 1.7;
}

.reader-content {
  margin-top: 24rpx;
  padding: 30rpx;
}

.reader-section {
  padding-top: 26rpx;
  border-top: 2rpx solid rgba(235, 226, 220, 0.75);
}

.reader-section:first-child {
  padding-top: 0;
  border-top: 0;
}

.reader-section + .reader-section {
  margin-top: 26rpx;
}

.reader-section__title {
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.5;
}

.reader-section__content {
  margin-top: 18rpx;
  color: #5d4e46;
  font-size: 30rpx;
  line-height: 2;
  white-space: pre-wrap;
}

.reader-content__btn {
  margin-top: 30rpx;
}

.reader-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 0 8rpx 10rpx;
}

.reader-footer__link {
  color: #c4956a;
  font-size: 26rpx;
  font-weight: 700;
}

.reader-footer__link--disabled {
  color: #d7c8be;
}
