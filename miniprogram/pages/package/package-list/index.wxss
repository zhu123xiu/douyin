.package-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.package-tabs {
  display: flex;
  margin-bottom: 24rpx;
  padding: 6rpx;
  border-radius: 24rpx;
  background: #f0e7e1;
}

.package-tab {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  color: #927f75;
  font-size: 26rpx;
  text-align: center;
}

.package-tab--active {
  background: #ffffff;
  color: #c4956a;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(112, 85, 71, 0.06);
}

.package-list-card {
  overflow: hidden;
}

.package-list-card__cover {
  min-height: 170rpx;
  padding: 28rpx;
  color: #ffffff;
}

.package-list-card__title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.45;
}

.package-list-card__badge {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.package-list-card__body {
  padding: 26rpx 28rpx 28rpx;
}

.package-list-card__meta {
  color: #8e827c;
  font-size: 22rpx;
}

.package-list-card__intro {
  margin-top: 16rpx;
  color: #5d4e46;
  font-size: 25rpx;
  line-height: 1.7;
}

.package-list-card__footer {
  margin-top: 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.package-list-card__price {
  color: #c4956a;
  font-size: 26rpx;
  font-weight: 700;
}
