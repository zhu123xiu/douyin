page {
  background: #fff9f5;
  color: #30231e;
  font-size: 28rpx;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 40rpx;
}

.hero-card,
.soft-card,
.progress-card,
.menu-card,
.topic-card,
.script-card,
.package-card,
.reco-card {
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 28rpx rgba(125, 96, 80, 0.08);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 48rpx 0 24rpx;
}

.section-heading__left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-heading__bar {
  width: 10rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #c4956a;
}

.section-heading__title {
  font-size: 36rpx;
  font-weight: 700;
}

.section-heading__action {
  font-size: 24rpx;
  color: #907d74;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  font-size: 21rpx;
  color: #8e827c;
  background: #f6f1ee;
}

.tag--secondary {
  background: #fff0e8;
  color: #dc8068;
}

.tag--coral {
  background: #fff0e9;
  color: #bf7b66;
}

.tag--blue {
  background: #eaf4ff;
  color: #659acc;
}

.tag--purple {
  background: #f1e9ff;
  color: #8b67bd;
}

.primary-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 28rpx;
  background: #c4956a;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ghost-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 28rpx;
  border: 2rpx solid #c4956a;
  color: #c4956a;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdfb;
}

.text-link {
  display: inline-flex;
  align-items: center;
  color: #907d74;
  font-size: 24rpx;
}

.helper-text {
  font-size: 22rpx;
  color: #9f948e;
}

.empty-state,
.loading-state {
  padding: 42rpx 28rpx;
  text-align: center;
  color: #9f948e;
  font-size: 24rpx;
}

.error-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff0e8;
  color: #a96751;
  font-size: 24rpx;
  line-height: 1.6;
}

.star-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff4e8;
  box-shadow: 0 8rpx 20rpx rgba(120, 90, 74, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c4956a;
  font-size: 34rpx;
}

.chevron {
  color: #c8bbb2;
  font-size: 34rpx;
  line-height: 1;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  border-radius: 999rpx;
  background: #efe5de;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #c4956a, #e0a998);
}

.status-dot-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e9dfd7;
}

.status-dot--done {
  background: #c4956a;
}

.status-dot--current {
  background: #fff9f5;
  border: 4rpx solid #c4956a;
}

.divider {
  width: 100%;
  height: 2rpx;
  background: rgba(210, 195, 184, 0.55);
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%);
  background-size: 400% 100%;
  animation: sk 1.4s ease infinite;
}

@keyframes sk {
  0% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0 50%;
  }
}
